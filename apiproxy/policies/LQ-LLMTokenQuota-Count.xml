<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<LLMTokenQuota continueOnError="true" enabled="true" name="LQ-LLMTokenQuota-Count">
    <DisplayName>LQ-LLMTokenQuota-Count</DisplayName>
    <CountOnly>true</CountOnly>
    <Identifier ref="verifyapikey.VA-VerifyAPIKey.developer.email"/>
    <LLMModelSource>{model_name}</LLMModelSource>
    <LLMTokenUsageSource>{jsonPath('$.usageMetadata.totalTokenCount',response.content,true)}</LLMTokenUsageSource>
    <SharedName>AGY-Gateway-LLMTokenQuota</SharedName>
    <UseQuotaConfigInAPIProduct stepName="VA-VerifyAPIKey">
        <DefaultConfig>
            <Allow>1000000</Allow>
            <Interval>1</Interval>
            <TimeUnit>day</TimeUnit>
        </DefaultConfig>
    </UseQuotaConfigInAPIProduct>
</LLMTokenQuota>
