<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<LLMTokenQuota continueOnError="false" enabled="true" name="LQ-LLMTokenQuota-Count">
    <DisplayName>LQ-LLMTokenQuota-Count</DisplayName>
    <CountOnly>true</CountOnly>
    <Identifier ref="cost_center"/>
    <LLMModelSource>{model_name}</LLMModelSource>
    <LLMTokenUsageSource>{llm_total_tokens}</LLMTokenUsageSource>
    <SharedName>AGY-Gateway-LLMTokenQuota</SharedName>
    <UseQuotaConfigInAPIProduct stepName="VA-VerifyAPIKey">
        <DefaultConfig>
            <Allow>1000000</Allow>
            <Interval>1</Interval>
            <TimeUnit>day</TimeUnit>
        </DefaultConfig>
    </UseQuotaConfigInAPIProduct>
</LLMTokenQuota>
