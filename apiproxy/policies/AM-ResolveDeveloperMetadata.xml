<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<AssignMessage async="false" continueOnError="false" enabled="true" name="AM-ResolveDeveloperMetadata">
    <DisplayName>AM-ResolveDeveloperMetadata</DisplayName>
    <Properties/>
    <IgnoreUnresolvedVariables>true</IgnoreUnresolvedVariables>
    <!-- Prefer Developer (employee) custom attribute 'x-cost-center'; if absent, 'cost_center' retains the X-Cost-Center header value -->
    <AssignVariable>
        <Name>cost_center</Name>
        <Ref>verifyapikey.VA-VerifyAPIKey.developer.x-cost-center</Ref>
    </AssignVariable>
</AssignMessage>
