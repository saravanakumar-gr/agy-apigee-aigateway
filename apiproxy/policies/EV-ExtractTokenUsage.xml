<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<ExtractVariables async="false" continueOnError="true" enabled="true" name="EV-ExtractTokenUsage">
    <DisplayName>EV-ExtractTokenUsage</DisplayName>
    <Properties/>
    <IgnoreUnresolvedVariables>true</IgnoreUnresolvedVariables>
    <Source clearPayload="false">response</Source>
    <Variable name="response.content">
        <Pattern ignoreCase="true">*"totalTokenCount": {llm_total_tokens},*</Pattern>
        <Pattern ignoreCase="true">*"totalTokenCount":{llm_total_tokens},*</Pattern>
    </Variable>
    <JSONPayload>
        <Variable name="llm_total_tokens" type="integer">
            <JSONPath>$.usageMetadata.totalTokenCount</JSONPath>
        </Variable>
    </JSONPayload>
</ExtractVariables>
