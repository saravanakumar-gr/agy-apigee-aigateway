<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<DataCapture async="false" continueOnError="true" enabled="true" name="DC-CaptureGatewayAnalytics">
    <DisplayName>DC-CaptureGatewayAnalytics</DisplayName>
    <IgnoreUnresolvedVariables>true</IgnoreUnresolvedVariables>
    <Capture>
        <Collect ref="model_name" default="unknown-model"/>
        <DataCollector>dc_ax_model_used</DataCollector>
    </Capture>
    <Capture>
        <Collect ref="llmTokenQuota.response.token.count" default="0"/>
        <DataCollector>dc_tokens</DataCollector>
    </Capture>
    <Capture>
        <Collect ref="cost_center" default="Platform-Engineering"/>
        <DataCollector>dc_cost_center</DataCollector>
    </Capture>
</DataCapture>
