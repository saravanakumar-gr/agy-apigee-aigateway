<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<DataCapture async="false" continueOnError="true" enabled="true" name="DC-CaptureGatewayAnalytics">
    <DisplayName>DC-CaptureGatewayAnalytics</DisplayName>
    <IgnoreUnresolvedVariables>true</IgnoreUnresolvedVariables>
    <Capture>
        <Collect ref="model_name" default="unknown-model"/>
        <DataCollector>dc_ax_model_used</DataCollector>
    </Capture>
    <Capture>
        <DataCollector>dc_tokens</DataCollector>
        <Collect default="0">
            <Source>response.event.current.data</Source>
            <JSONPayload>
                <JSONPath>$.usageMetadata.totalTokenCount</JSONPath>
            </JSONPayload>
        </Collect>
    </Capture>
    <Capture>
        <Collect ref="cost_center" default="Unassigned"/>
        <DataCollector>dc_cost_center</DataCollector>
    </Capture>
</DataCapture>
